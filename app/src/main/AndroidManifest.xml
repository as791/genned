<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No storage/camera/network permissions are requested for the normal
      share-to-check flow. Images arrive via content:// URIs (share sheet /
      Photo Picker), which grant temporary, scoped read access without any
      permission of ours. See internal-docs/PRIVACY.md.

      The permissions below back ONE feature only: the opt-in, off-by-default
      "Screen Overlay" experiment (Settings -> Experimental) that lets a floating
      bubble capture and analyze whatever is currently on screen — e.g. inside
      Instagram/WhatsApp, which no share-sheet or intent-filter can reach. See
      internal-docs/ARCHITECTURE.md "Screen overlay (experimental)" and internal-docs/PRIVACY.md for
      exactly what this does and does not do, and why it is not enabled by default.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!--
      Optional, asked only from the bubble's setup screen: lets Android 13+ show the bubble's
      own notification (Stop button, last result). The bubble works without it.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Content Credentials (c2pa-android) needs Android 9 (API 28). The app still runs on 8.x:
      every call into it is behind an SDK check (C2PAProvider). The library and its
      dependencies also ask for INTERNET (remote manifests, signing services) and biometric
      permissions (signing keys). Genned only reads embedded credentials, offline, so they
      are removed. CI fails the build if any of them comes back.
    -->
    <uses-sdk tools:overrideLibrary="org.contentauth.c2pa" />
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <application
        android:name=".GennedApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Genned">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Genned.Starting">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Share sheet entry point: "Share" -> Genned from any app. Both SEND
              and SEND_MULTIPLE are declared: several share panels (notably Samsung's
              Gallery "Share via" sheet) dispatch SEND_MULTIPLE even for a single
              selected item, and an app that only declares SEND simply never appears
              for those sources. Only the first item is analyzed on a multi-select
              share; batch analysis is future scope (see internal-docs/ROADMAP.md).
              video/* is accepted alongside image/* so Reels/Shorts-style video
              shares route in too (see AnalyzeVideoUseCase).
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!--
              Opening a local image file directly (e.g. a file manager "Open with").
              No BROWSABLE category: this isn't a web/app-link, only ever a local
              content:// or file:// URI from another on-device app. Schemes are
              listed explicitly (rather than relying on the platform's documented
              content:/file: default for a scheme-less <data> element) so Android
              Lint's AppLinkUrlError check can see this is intentional, not a
              malformed deep link.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="image/*" />
                <data android:scheme="file" android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
          Experimental screen-overlay capture (see comment above the permissions
          block). Only ever started explicitly from Settings when the user turns
          the experiment on, and only after MediaProjection consent is granted for
          that session — never started at boot or in the background otherwise.
        -->
        <service
            android:name=".overlay.OverlayCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Grants temporary read access to the generated shareable result-card PNG. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
