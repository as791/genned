    <!-- Experimental screen overlay -->
    <string name="settings_experimental_heading">Experimental</string>
    <string name="settings_overlay_body">A floating bubble you can tap while inside another app (e.g. Instagram, WhatsApp) to check whatever is currently on screen — including content those apps only let you forward internally, which no share button can reach. This works by capturing the screen (not by reading the other app\'s content or automatically analyzing everything you scroll past), analyzes only when you tap, and is off by default.</string>
    <string name="settings_overlay_enable">Enable overlay bubble</string>
    <string name="settings_overlay_permission_overlay">Grant \"draw over other apps\" permission first, then turn this back on.</string>
    <string name="settings_overlay_permission_usage">Grant \"usage access\" permission first (so the bubble knows when Instagram/WhatsApp is open), then turn this back on.</string>
    <string name="overlay_notification_channel">Genned overlay</string>
    <string name="overlay_notification_title">Genned overlay is active</string>
    <string name="overlay_notification_body">Tap the floating bubble over Instagram or WhatsApp to check what\'s on screen.</string>
    <string name="overlay_notification_stop">Stop</string>
    <string name="overlay_projection_stopped_toast">Genned overlay stopped: screen capture permission ended. Turn the overlay back on in Settings to keep using it.</string>
    <string name="settings_debug_log_heading">Overlay debug log</string>
    <string name="settings_debug_log_body">If the overlay bubble isn\'t behaving right (not appearing over an app, or using more battery than expected), copy the log below and share it — it only contains app package names, timestamps, and the bubble\'s show/hide decisions, never any screen content.</string>
